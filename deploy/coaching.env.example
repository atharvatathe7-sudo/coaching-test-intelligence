# Copy to /etc/coaching/coaching.env, then:
#   chown root:coaching /etc/coaching/coaching.env
#   chmod 0640 /etc/coaching/coaching.env
# Never commit the real file.
#
# No application secret is needed: sessions use random server-side
# tokens. Passwords are set with scripts/manage.py, never stored here.

COACHING_ENV=production
COACHING_DB_PATH=/var/lib/coaching/coaching.db
COACHING_BACKUP_DIR=/var/backups/coaching

# Session cookies are always Secure in production (HTTPS only);
# COACHING_COOKIE_SECURE has no effect here.
