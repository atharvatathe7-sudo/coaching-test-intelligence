# Example settings for LOCAL PROTOTYPE mode (scripts/run_local.py).
# Copy to <data dir>/config/local.env and start with:
#   python scripts/run_local.py --env-file <data dir>/config/local.env
# Real environment variables always win over this file.
# Every line is optional; the values shown are the defaults.
# No secrets belong here: there is no application secret, and passwords
# are set with scripts/manage.py, never stored in a file.

# Where the database, backups, uploads, logs and exports live.
# Default on Windows: %LOCALAPPDATA%\CoachingIntel
# Default on Linux/macOS: ~/.local/share/CoachingIntel
# COACHING_DATA_DIR=

# Overrides only the database file (default: <data dir>/data/coaching.db).
# COACHING_DB_PATH=

# Address and port. 127.0.0.1 means only this computer can connect.
# Use 0.0.0.0 ONLY to let other computers on your network connect; that
# traffic is plain HTTP (not encrypted) and anyone on the network who can
# sign in can use the app. Allow the port through the firewall yourself.
# COACHING_HOST=127.0.0.1
# COACHING_PORT=8000
